# Copy this file to .env and fill in real values. Never commit .env.

# --- Core ---
DEBUG=True
SECRET_KEY=django-insecure-change-this-to-a-random-50-character-string
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000

# --- Database (PostgreSQL) ---
# Format: postgres://USER:PASSWORD@HOST:PORT/NAME
DATABASE_URL=postgres://fms_user:fms_password@localhost:5432/fms_db

# --- Redis / Celery ---
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# --- Email ---
# Use console backend in development so emails print to the terminal.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=FMS Admin <no-reply@example.com>

# --- File uploads ---
MAX_UPLOAD_SIZE_MB=5

# --- TLS (only relevant when DEBUG=False) ---
# Only enable these once a real TLS-terminating reverse proxy (nginx, load balancer)
# sits in front of this app — otherwise SECURE_SSL_REDIRECT will 301-loop.
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_HSTS_SECONDS=0

# Comms (Raw DB / App DB) -> FMS live data feed
# COMMS_APP_DATABASE_URL=postgres://user:password@localhost:5432/APPDB
# COMMS_SYNC_AUTOSTART=True        # sync from a background thread inside the web server
# COMMS_SYNC_INTERVAL_SECONDS=2   # a pass takes ~0.1 s; 2 s keeps alerts near real time
# Optional, read-only: the comms Raw DB, so Panic alerts show the panic input voltage (analog1)
# COMMS_RAW_DATABASE_URL=postgres://user:password@localhost:5432/COMMSDB

# --- Alerts ---
# Only alert events newer than this (minutes) notify users (bell, popup, sound)
# ALERT_NOTIFY_MAX_AGE_MINUTES=1440
# Over Speeding: a start (eventioval 255) pairs with the next 255 only within this many minutes
# OVERSPEED_MAX_EPISODE_MINUTES=30
# Geofences: exit only beyond this distance outside the boundary; crossings need this many readings
# GEOFENCE_EXIT_TOLERANCE_METERS=20
# GEOFENCE_CONFIRM_READINGS=2

# --- Trip Report downloads (route map tiles for the trip PDF/Excel) ---
# Leave empty to draw the route without a basemap (no outbound requests).
TRIP_REPORT_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
